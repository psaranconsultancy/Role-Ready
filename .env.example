# ---- Frontend (.env.local, gitignored). Safe in the browser: RLS protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable anon key from Supabase > Project Settings > API>
# true = UI runs on src/mocks (no backend needed). Set false once the functions are deployed.
VITE_USE_MOCKS=true

# ---- Edge functions (supabase/functions/.env for local `supabase functions serve`, gitignored).
# In the cloud these are set once with: supabase secrets set GEMINI_API_KEY=... LLM_PROVIDER=gemini
# Never prefix these with VITE_ and never commit real values.
LLM_PROVIDER=gemini            # gemini | anthropic
GEMINI_API_KEY=<your own free key from aistudio.google.com>
ANTHROPIC_API_KEY=             # optional fallback, paid API (not covered by a Claude subscription)

